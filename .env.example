OPENROUTER_API_KEY=
# Optional: Modell überschreiben (Standard: gemini-2.5-pro + gpt-4.1-mini)
# Empfohlene Modelle:
#   google/gemini-2.5-pro-preview   — Bestes Preis/Leistung, starkes Deutsch
#   anthropic/claude-sonnet-4-6     — Beste Reasoning-Qualität, teurer
#   openai/gpt-4.1                  — Zuverlässiges JSON, gute Nuancen
#   google/gemini-3-flash-preview   — Budget-Option, schnell aber weniger genau
# OPENROUTER_MODEL_PRIMARY=google/gemini-2.5-pro-preview
# OPENROUTER_MODEL_FALLBACK=openai/gpt-4.1-mini
# OPENROUTER_HEDGE=1
# OPENROUTER_REPAIR=1
# OPENROUTER_DEADLINE_MS=10000
# OPENROUTER_REQUEST_TIMEOUT_MS=9000
#
# Async (Option C): Hintergrund-Jobs dürfen länger laufen
# OPENROUTER_ASYNC_DEADLINE_MS=90000
# OPENROUTER_ASYNC_REQUEST_TIMEOUT_MS=25000

# Rate-Limit (standardmäßig nur in Production aktiv)
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=60000

# MVP: Jede erfolgreiche Bewertung als JSON-Zeile nach logs/evaluations.jsonl loggen
# LOG_EVALUATIONS=1

# SQLite-Datenbank für persistente Evaluierungen
# DB_PATH=./data/evaluations.db
